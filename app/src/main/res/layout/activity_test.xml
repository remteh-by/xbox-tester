<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:ads="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="16dp">
            <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Xbox Tester" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnReports" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Отчёты" android:textAllCaps="false" android:textSize="14sp" />
            <TextView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:text="×" android:textSize="28sp" android:gravity="center" android:textColor="@color/text_secondary" android:contentDescription="Закрыть приложение" android:clickable="true" android:focusable="true" />
        </LinearLayout>
        <View android:id="@+id/accentBar" android:layout_width="48dp" android:layout_height="3dp" android:layout_marginBottom="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/mainColumns" android:orientation="@integer/content_orientation" android:baselineAligned="false">
            <LinearLayout android:layout_width="@dimen/panel_width" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="@dimen/column_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="16dp">
                    <LinearLayout android:id="@+id/controllerHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="@integer/photo_orientation" android:gravity="center_vertical">
                        <ImageView android:id="@+id/controllerPhoto" android:layout_width="@dimen/photo_width" android:layout_height="140dp" android:src="@drawable/controller_photo" android:scaleType="fitCenter" android:contentDescription="Xbox Series · Carbon Black" />
                        <LinearLayout android:layout_width="@dimen/hero_text_width" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="12dp">
                            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Подключите контроллер" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:accessibilityLiveRegion="polite" />
                            <TextView android:id="@+id/tvControllerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="USB или Bluetooth. Затем нажмите любую кнопку." android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingTop="10dp" android:paddingBottom="14dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="На фото: Xbox Series · Carbon Black" android:textSize="12sp" android:textColor="@color/text_primary" android:paddingTop="10dp" android:paddingBottom="6dp" />
                    <LinearLayout android:id="@+id/sessionActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                    <TextView android:id="@+id/photoCredits" android:layout_width="match_parent" android:layout_height="48dp" android:text="Источник фотографии ↗" android:textColor="@color/text_secondary" android:textSize="13sp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="@dimen/panel_width" android:layout_height="wrap_content" android:layout_weight="1.6" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="18dp" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Стики и триггеры" android:textSize="19sp" android:textColor="@color/text_primary" android:textStyle="bold" android:paddingBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="6dp">
                            <TextView android:id="@+id/tvTriggerLLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LT" android:textColor="@color/text_primary" android:textSize="13sp" android:paddingBottom="4dp" />
                            <com.remteh.xboxtester.view.TriggerView android:id="@+id/triggerLT" android:layout_width="match_parent" android:layout_height="48dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Интервал событий" android:textColor="@color/text_secondary" android:textSize="13sp" android:letterSpacing="0.15" />
                            <TextView android:id="@+id/tvLatency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="— ms" android:textColor="@color/text_secondary" android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginStart="6dp">
                            <TextView android:id="@+id/tvTriggerRLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RT" android:textColor="@color/text_primary" android:textSize="13sp" android:paddingBottom="4dp" />
                            <com.remteh.xboxtester.view.TriggerView android:id="@+id/triggerRT" android:layout_width="match_parent" android:layout_height="48dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Левый стик" android:textColor="@color/text_primary" android:textSize="13sp" android:letterSpacing="0.1" android:paddingBottom="4dp" />
                            <com.remteh.xboxtester.view.StickView android:id="@+id/stickLeft" android:layout_width="match_parent" android:layout_height="140dp" />
                            <TextView android:id="@+id/tvLeftStick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Не измерено" android:textColor="@color/text_secondary" android:textSize="13sp" android:fontFamily="monospace" android:paddingTop="4dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Правый стик" android:textColor="@color/text_primary" android:textSize="13sp" android:letterSpacing="0.1" android:paddingBottom="4dp" />
                            <com.remteh.xboxtester.view.StickView android:id="@+id/stickRight" android:layout_width="match_parent" android:layout_height="140dp" />
                            <TextView android:id="@+id/tvRightStick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Не измерено" android:textColor="@color/text_secondary" android:textSize="13sp" android:fontFamily="monospace" android:paddingTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="18dp" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Кнопки" android:textSize="19sp" android:textColor="@color/text_primary" android:textStyle="bold" android:paddingBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Нажатий: " android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvPressCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingBottom="12dp">
                        <TextView android:id="@+id/btnLB" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="LB" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginEnd="6dp" />
                        <TextView android:id="@+id/btnRB" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="RB" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginStart="6dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingBottom="12dp">
                        <TextView android:id="@+id/btnL3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="L3" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/btnR3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="R3" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginStart="4dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingBottom="12dp">
                        <TextView android:id="@+id/btnFace1" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/face_btn_bg" android:gravity="center" android:text="A" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/btnFace2" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/face_btn_bg" android:gravity="center" android:text="B" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/btnFace3" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/face_btn_bg" android:gravity="center" android:text="X" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/btnFace4" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/face_btn_bg" android:gravity="center" android:text="Y" android:textColor="@color/text_primary" android:textSize="18sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingBottom="12dp">
                        <TextView android:id="@+id/btnDpadUp" android:layout_width="52dp" android:layout_height="48dp" android:background="@drawable/button_bg" android:gravity="center" android:text="↑" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/btnDpadDown" android:layout_width="52dp" android:layout_height="48dp" android:background="@drawable/button_bg" android:gravity="center" android:text="↓" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/btnDpadLeft" android:layout_width="52dp" android:layout_height="48dp" android:background="@drawable/button_bg" android:gravity="center" android:text="←" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/btnDpadRight" android:layout_width="52dp" android:layout_height="48dp" android:background="@drawable/button_bg" android:gravity="center" android:text="→" android:textColor="@color/text_primary" android:textSize="18sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingBottom="8dp">
                        <TextView android:id="@+id/btnSelect" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="VIEW" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginEnd="3dp" />
                        <TextView android:id="@+id/btnSystem" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="HOME" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                        <TextView android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="MENU" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginStart="3dp" />
                    </LinearLayout>
                    <TextView android:id="@+id/btnExtra" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/button_bg" android:gravity="center" android:text="SHARE" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginBottom="16dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="18dp" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Проверка вибрации" android:textSize="19sp" android:textColor="@color/text_primary" android:textStyle="bold" android:paddingBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
                        <TextView android:id="@+id/btnVibShort" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="Короткая" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginEnd="3dp" />
                        <TextView android:id="@+id/btnVibMedium" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="Средняя" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
                        <TextView android:id="@+id/btnVibLong" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="Длинная" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                        <TextView android:id="@+id/btnVibPattern" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_bg" android:gravity="center" android:text="Импульсы" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginStart="3dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="18dp" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Измерения" android:textSize="19sp" android:textColor="@color/text_primary" android:textStyle="bold" android:paddingBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Фильтр стиков: " android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <SeekBar android:id="@+id/seekDeadZone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="30" android:progress="8" android:contentDescription="Мёртвая зона только для отображения стиков" />
                        <TextView android:id="@+id/tvDeadZoneVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8%" android:textColor="@color/text_primary" android:textSize="13sp" android:paddingStart="8dp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvCalibInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/raw_data_bg" android:text="Двигай стики и жми триггеры для измерений" android:textColor="@color/text_secondary" android:textSize="13sp" android:fontFamily="monospace" android:padding="10dp" android:minHeight="56dp" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/btnResetCalib" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/button_bg" android:gravity="center" android:text="Новая сессия измерений" android:textColor="@color/text_secondary" android:textSize="13sp" android:letterSpacing="0.05" android:layout_marginBottom="16dp" />
                    <Button android:id="@+id/rawToggle" android:layout_width="match_parent" android:layout_height="48dp" android:text="Показать исходные данные" android:textAllCaps="false" android:textSize="14sp" />
                    <TextView android:id="@+id/tvRawData" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/raw_data_bg" android:text="Нет событий Android API" android:textColor="@color/text_secondary" android:textSize="13sp" android:fontFamily="monospace" android:padding="12dp" android:minHeight="72dp" android:layout_marginBottom="16dp" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/btnSupport" android:layout_width="match_parent" android:layout_height="48dp" android:text="♡ Поддержать бесплатные тесты RemTeh" android:textAllCaps="false" android:textSize="14sp" android:layout_marginBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RemTeh.by · Xbox Tester 1.2.1&#10;Измерения Android API · без записи в контроллер" android:textSize="13sp" android:textColor="@color/text_primary" android:paddingTop="8dp" android:paddingBottom="20dp" />
        <com.google.android.gms.ads.AdView android:id="@+id/adView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" ads:adSize="BANNER" ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />
    </LinearLayout>
</ScrollView>